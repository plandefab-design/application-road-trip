# Copy to .env (never committed) and fill in.

# Long random string. Paste the same value in the iPhone app (Réglages › Companion › Jeton).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PLANNER_TOKEN=

# Claude subscription token for the Agent SDK (personal use on your own PC).
# Generate on the PC with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Model used by the planner (leave empty for the SDK default).
PLANNER_MODEL=

# Java heap for GraphHopper (Alps + Languedoc-Roussillon ≈ 8g; lower if the PC has < 16 GB RAM).
GH_HEAP=8g
