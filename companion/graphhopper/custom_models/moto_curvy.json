// Twisty-road motorcycle model. Derived from GraphHopper's motorcycle.json + curvature.json.
// curvature = beeline / real distance per edge: 1.0 = straight, lower = curvier.
// Values below are a STARTING POINT — calibrate on reference roads in spike S4
// (Combe de Lourmarin, col de la Bonnette…) against Kurviger results.
{
  "distance_influence": 20,
  "priority": [
    { "if": "!car_access", "multiply_by": "0" },
    { "if": "track_type.ordinal() > 1", "multiply_by": "0" },
    { "if": "road_access == PRIVATE", "multiply_by": "0" },
    { "if": "road_class == TRACK", "multiply_by": "0" },
    { "if": "road_access == DESTINATION", "multiply_by": "0.1" },

    { "if": "road_class == MOTORWAY", "multiply_by": "0.01" },
    { "else_if": "road_class == TRUNK", "multiply_by": "0.1" },
    { "else_if": "road_class == PRIMARY", "multiply_by": "0.5" },

    { "if": "surface == COBBLESTONE || surface == GRAVEL || surface == SAND || surface == DIRT || surface == GROUND || surface == UNPAVED || surface == COMPACTED || surface == GRASS || surface == FINE_GRAVEL", "multiply_by": "0" },

    { "if": "curvature >= 0.98", "multiply_by": "0.3" },
    { "else_if": "curvature >= 0.9", "multiply_by": "0.7" },

    { "if": "road_environment == FERRY", "multiply_by": "0.1" },
    { "if": "toll == ALL", "multiply_by": "0.5" }
  ],
  "speed": [
    { "if": "true", "limit_to": "0.9 * car_average_speed" },
    { "if": "true", "limit_to": "110" }
  ]
}
