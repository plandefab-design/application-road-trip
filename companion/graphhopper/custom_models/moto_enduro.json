// Enduro profile: tracks and unpaved roads sought, big roads avoided. Only ways open to motor vehicles
// (car_access follows access / motor_vehicle tags: closed tracks are never proposed).
{
  "distance_influence": 15,
  "priority": [
    { "if": "!car_access", "multiply_by": "0" },
    { "if": "road_access == PRIVATE", "multiply_by": "0" },
    { "if": "road_access == DESTINATION", "multiply_by": "0.1" },

    { "if": "road_class == MOTORWAY", "multiply_by": "0.01" },
    { "else_if": "road_class == TRUNK", "multiply_by": "0.1" },
    { "else_if": "road_class == PRIMARY", "multiply_by": "0.3" },
    { "else_if": "road_class == SECONDARY", "multiply_by": "0.6" },

    { "if": "surface == ASPHALT || surface == CONCRETE || surface == PAVED || surface == PAVING_STONES", "multiply_by": "0.6" },
    { "if": "surface == SAND", "multiply_by": "0.5" },

    { "if": "curvature >= 0.98", "multiply_by": "0.6" },
    { "if": "road_environment == FERRY", "multiply_by": "0.1" }
  ],
  "speed": [
    { "if": "true", "limit_to": "0.9 * car_average_speed" },
    { "if": "true", "limit_to": "90" },
    { "if": "surface == GRAVEL || surface == FINE_GRAVEL || surface == COMPACTED || surface == UNPAVED || surface == DIRT || surface == GROUND || surface == SAND || surface == GRASS", "limit_to": "40" }
  ]
}
